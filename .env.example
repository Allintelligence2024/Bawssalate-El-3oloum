# ── المزامنة الاختيارية (Supabase) ──
# اتركهما فارغَين إذا لا تريد المزامنة — التطبيق يعمل offline بدون أي مشكل.
# أُنشئ مشروعًا مجانيًّا على https://supabase.com ثم:
#   Project Settings → API → Project URL و anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pilote web uniquement, désactivé par défaut. Projet Auth isolé, clé PUBLIQUE uniquement.
# Ne pas utiliser le projet de synchronisation historique pour le pilote.
VITE_VERIFICATION_SYNC=false
# VITE_VERIFICATION_ORIGINE=https://pilote.example.invalid
# VITE_VERIFICATION_AUTH_URL=https://projet-test.example.invalid
# VITE_VERIFICATION_AUTH_CLE=
# Activer seulement sur le projet de recette avec la proposition SQL 02 appliquée.
VITE_VERIFICATION_RPC_PILOTE=false

# ── Illustrations des leçons (Phase 2, pilote U6) ──
# Optionnel. Vide = repli local `${BASE_URL}lecons/img/` (fichiers WebP du dépôt).
# Pour Cloudflare R2 : URL de base du dossier qui contient les .webp, avec ou sans
# slash final. Ex. VITE_ILLUSTRATIONS_BASE_URL=https://pub-xxxx.r2.dev/lecons/img/
# Les images ne sont jamais précachées : chargement lazy + cache à la première ouverture.
VITE_ILLUSTRATIONS_BASE_URL=


node_modules/
dist/
*.tsbuildinfo
.vite/
.DS_Store
*.log
__pycache__/
*.pyc

# مفاتيح Supabase الحقيقية — لا تُرفع أبدًا
.env
.env.local
.env.production

# Certificats de test QA (clés privées — régénérer via New-SelfSignedCertificate)
*.pfx
*.pem
*.key

# Fichiers PDF d'annales tiers retirés du dépôt public (81 Mo — droits ONEC/dzexams)
plans/sources/sujets/
dist-relecture-svt/

# Artefacts de build Android / Gradle
android/app/build/
android/build/
android/.gradle/

# Outils agents locaux (OpenCode, skills)
.agents/
skills-lock.json
opencode.json

# Archives produites localement (packs d'audit, exports, dumps)
*.zip

# Preuves visuelles QA : conservées sur le poste, hors dépôt (poids, aucun usage
# par l'application). Les outils qui les produisent restent suivis.
plans/screenshots/*.png
plans/screenshots/*.raw
plans/captures/*.png
plans/sources/medias/*.jpg
# Planches de contrôle des schémas (visuel + pastilles) : preuves QA locales,
# régénérables par « python scripts/previsualiser-schemas.py ». Le script reste suivi.
plans/preuves-schemas/*.png

# Maquette de référence (HTML/CSS/JS autonomes, jamais bundlée) : archivée hors Git
maquettes/

# Copie figée du dépôt telle qu'elle a été livrée + captures de contrôle
NEW bawssala/

# Phase 2/3 — illustrations du manuel : l'inventaire Drive et les copies JPEG brutes
# ne sont JAMAIS versionnés. Seuls les WebP optimisés de public/lecons/img/ entrent
# dans Git (contrôlé par scripts/importer-images-lecons.mjs et verifier-hors-ligne.mjs).
plans/inventaire-images-livre.json
plans/_travail-images/
.cache/

# Phase 3–5 — espace local de prévisualisation/staging R2 (hors Git ; les 65 MP3 intégrés
# dans l'application vivent dans public/audio/{lecons,mourchid}/, hors précache).
plans/_audio-r2/

# Exports temporaires d'audit (Blocs E/F) : conservés sur le poste, jamais versionnés.
audit-v2-*.md

# Dossier d'audit interne (rapports, matrice, prompts) — jamais versionné.
/audit/

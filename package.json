{
  "name": "bousala-al-ouloum-lite",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "description": "بوصلة العلوم Lite — تطبيق مراجعة مادة علوم الطبيعة والحياة — بكالوريا علوم تجريبية (الجزائر) — وفق بروتوكول المراجعة في 6 مراحل",
  "scripts": {
    "dev": "vite --host --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 3000",
    "test": "vitest run && node --test scripts/verifier-inventaire-boussole.test.mjs",
    "verifier:inventaire-boussole": "node scripts/verifier-inventaire-boussole.mjs",
    "verifier:deploiement": "node scripts/verifier-deploiement.mjs",
    "lint": "eslint .",
    "verifier:metriques": "node scripts/sync-metrics.mjs --check",
    "verifier:parite-rls": "node scripts/verifier-parite-rls.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@noble/hashes": "1.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "jsdom": "^24.0.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
